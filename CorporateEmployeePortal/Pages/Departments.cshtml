@page
@model DepartmentsModel
@{
    ViewData["Title"] = "Departments";
}

<h2>Company Departments</h2>
<p>Information about TechCorp departments and teams.</p>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">IT Department</h5>
                <p class="card-text">Software development and technical support.</p>
                <small class="text-muted">Building A, Floor 3</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Human Resources</h5>
                <p class="card-text">Employee services and company policies.</p>
                <small class="text-muted">Building B, Floor 1</small>
            </div>
        </div>
    </div>
</div>